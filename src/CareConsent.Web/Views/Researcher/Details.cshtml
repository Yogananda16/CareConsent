@model EnrollmentDetailsViewModel
@{
    ViewData["Title"] = $"Enrollment {Model.Id}";
    string Time(DateTime? value) => value is null ? "–" : value.Value.ToString("yyyy-MM-dd HH:mm") + " UTC";
}

<p><a asp-action="Index">&larr; Back to the dashboard</a></p>

<h1>Enrollment @Model.Id</h1>
<p class="text-muted">@Model.StudyTitle</p>

@* Razor HTML-encodes every @value below, so text typed by a participant
   is shown as plain text and can never run as a script. *@

<h2 class="h5 mt-4">Enrollment</h2>
<dl class="row">
    <dt class="col-sm-3">Participant email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Enrollment ID</dt>
    <dd class="col-sm-9">@Model.Id</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9" id="detail-status">@Model.Status</dd>
    <dt class="col-sm-3">Enrolled at</dt>
    <dd class="col-sm-9">@Time(Model.StartedAt)</dd>
    <dt class="col-sm-3">Completed at</dt>
    <dd class="col-sm-9">@Time(Model.CompletedAt)</dd>
</dl>

<h2 class="h5 mt-4">Consent</h2>
<dl class="row">
    <dt class="col-sm-3">Consent status</dt>
    <dd class="col-sm-9" id="detail-consent">@(Model.ConsentGiven ? "Given" : "Not given")</dd>
    <dt class="col-sm-3">Consented at</dt>
    <dd class="col-sm-9">@Time(Model.ConsentedAt)</dd>
    <dt class="col-sm-3">Consent version</dt>
    <dd class="col-sm-9" id="detail-consent-version">@(Model.ConsentVersion ?? "–")</dd>
</dl>

<h2 class="h5 mt-4">Screening answers</h2>
<div class="table-responsive">
    <table class="table" style="max-width: 56rem;">
        <thead>
            <tr><th>Question</th><th>Answer</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Answers)
            {
                <tr>
                    <td>@item.Question</td>
                    <td>
                        @if (item.Answer is null)
                        {
                            <span class="text-muted">No answer</span>
                        }
                        else
                        {
                            @item.Answer
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
