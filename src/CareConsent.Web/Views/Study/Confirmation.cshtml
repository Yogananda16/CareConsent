@model ConfirmationViewModel
@{
    ViewData["Title"] = "Confirmation";
}

<h1>Thank you</h1>
<p class="lead">You have finished the @Model.StudyTitle.</p>

<h2 class="h5 mt-4">Your consent</h2>
<dl class="row">
    <dt class="col-sm-3">Record</dt>
    <dd class="col-sm-9"><a asp-action="Record" asp-route-id="@Model.EnrollmentId">Record number @Model.EnrollmentId</a></dd>
    <dt class="col-sm-3">Signed as</dt>
    <dd class="col-sm-9">@Model.TypedName</dd>
    <dt class="col-sm-3">Signed at</dt>
    <dd class="col-sm-9">@Model.SignedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
    <dt class="col-sm-3">Consent version</dt>
    <dd class="col-sm-9">@Model.ConsentVersion</dd>
    @if (Model.CompletedAt is not null)
    {
        <dt class="col-sm-3">Completed at</dt>
        <dd class="col-sm-9">@Model.CompletedAt.Value.ToString("yyyy-MM-dd HH:mm") UTC</dd>
    }
</dl>

<h2 class="h5 mt-4">Your answers</h2>
<table class="table" style="max-width: 48rem;">
    <thead>
        <tr><th>Question</th><th>Answer</th></tr>
    </thead>
    <tbody>
        @foreach (var answer in Model.Answers)
        {
            <tr><td>@answer.Question</td><td>@answer.Answer</td></tr>
        }
    </tbody>
</table>

<a class="btn btn-link" asp-controller="Home" asp-action="Index">Back to home</a>
