@model QuestionnaireViewModel
@{
    ViewData["Title"] = "Screening questionnaire";
}

<h1>Screening questionnaire</h1>
<p class="text-muted">@Model.StudyTitle &middot; Step 2 of 2</p>
<p>These questions are fictional and are not a medical assessment.</p>

<form asp-action="Questionnaire" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @for (var i = 0; i < Model.Items.Count; i++)
    {
        var item = Model.Items[i];
        <fieldset class="mb-4">
            <legend class="fs-6 fw-semibold">@(i + 1). @item.Text</legend>
            <input type="hidden" name="Items[@i].QuestionId" value="@item.QuestionId" />

            @switch (item.Type)
            {
                case QuestionType.YesNo:
                    foreach (var option in new[] { "Yes", "No" })
                    {
                        <div class="form-check form-check-inline">
                            <input asp-for="Items[i].Answer" type="radio" value="@option" id="q@(i)_@option" class="form-check-input" />
                            <label class="form-check-label" for="q@(i)_@option">@option</label>
                        </div>
                    }
                    break;

                case QuestionType.Scale:
                    for (var n = 1; n <= 5; n++)
                    {
                        <div class="form-check form-check-inline">
                            <input asp-for="Items[i].Answer" type="radio" value="@n" id="q@(i)_@n" class="form-check-input" />
                            <label class="form-check-label" for="q@(i)_@n">@n</label>
                        </div>
                    }
                    break;

                case QuestionType.Number:
                    <input asp-for="Items[i].Answer" type="number" min="0" max="50" step="1" class="form-control" style="max-width: 8rem;" />
                    break;

                default:
                    <textarea asp-for="Items[i].Answer" rows="3" maxlength="1000" class="form-control" style="max-width: 32rem;"></textarea>
                    <div class="form-text">Optional. Do not enter real information.</div>
                    break;
            }

            <span asp-validation-for="Items[i].Answer" class="text-danger d-block"></span>
        </fieldset>
    }

    <button type="submit" class="btn btn-primary">Submit answers</button>
</form>
